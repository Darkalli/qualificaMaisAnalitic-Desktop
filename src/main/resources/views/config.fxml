<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<DialogPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.qualificamaisanaliticinterface.config.ConfigController"
            fx:id="configPane" prefWidth="560" minWidth="520"
            styleClass="dialog-pane, config-dialog"
            stylesheets="@../css/application.css, @../css/navigation.css, @../css/config.css">
    <content>
        <VBox spacing="20" styleClass="config-content">
            <VBox spacing="4">
                <Label text="Configurações" styleClass="config-heading"/>
                <Label text="Conexões do sistema" styleClass="config-description"/>
            </VBox>
            <GridPane hgap="16" vgap="16" styleClass="config-fields">
                <columnConstraints>
                    <ColumnConstraints minWidth="126" prefWidth="126" maxWidth="126"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="0"/>
                </columnConstraints>
                <Label text="Endereço da API" styleClass="config-field-label" labelFor="${apiUrlField}"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="apiUrlField"
                           accessibleText="Endereço da API" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="URL do Superset" styleClass="config-field-label" labelFor="${supersetUrlField}"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="supersetUrlField"
                           accessibleText="URL do Superset" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>
            <VBox spacing="8">
                <Label text="Os endereços salvos serão usados ao reabrir o aplicativo."
                       styleClass="config-description" wrapText="true"/>
                <Label fx:id="configError" styleClass="config-error" wrapText="true"
                       visible="false" managed="false"/>
                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="saveButton" text="Salvar" onAction="#onSaveClick"
                            defaultButton="true" styleClass="icon-button">
                        <graphic>
                            <FontIcon iconLiteral="fas-save"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </content>
</DialogPane>

