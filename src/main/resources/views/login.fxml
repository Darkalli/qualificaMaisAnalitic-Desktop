<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Hyperlink?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.qualificamaisanaliticinterface.HelloController"
      prefWidth="360" minWidth="350" styleClass="side-menu" spacing="12">

    <HBox alignment="CENTER_LEFT" spacing="2" styleClass="login-brand">
        <Label text="Qualifica"
               styleClass="title, brand-name"/>
        <Label text="+"
               styleClass="title, brand-plus"/>
        <Label text="Ijui"
               styleClass="title, brand-city"/>
    </HBox>

    <Label text="Usuário:"/>
    <TextField fx:id="userField"
               promptText="Digite seu nome de usuário"
               styleClass="search-field"
               HBox.hgrow="ALWAYS"/>

    <Label text="Senha:"/>
    <StackPane>
        <PasswordField fx:id="passwordField"
                       promptText="Digite sua senha"
                       styleClass="search-field"
                       style="-fx-padding: 10px 80px 10px 12px;" />
        <TextField fx:id="visiblePasswordField"
                   promptText="Digite sua senha"
                   styleClass="search-field"
                   HBox.hgrow="ALWAYS" style="-fx-padding: 10px 80px 10px 12px;"
                   visible="false" managed="false"/>
        <Hyperlink text="Mostrar" styleClass="clear-filters" onAction="#onTogglePassword" StackPane.alignment="CENTER_RIGHT"
                   style="-fx-translate-x: -12px;"/>
    </StackPane>
    <CheckBox fx:id="persistLoginCheckBox" text="Manter conectado" styleClass="checkBox" selected="true"/>
    <Label fx:id="loginErrorLabel"
           styleClass="login-error"
           visible="false"
           managed="false"
           wrapText="true"
           prefWidth="460"
           maxWidth="460"
           alignment="CENTER"/>
    <Button styleClass="button" text="Login"
            onAction="#onClick"/>
</VBox>
