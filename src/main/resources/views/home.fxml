<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import java.lang.String?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.FlowPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane fx:id="homePane" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.qualificamaisanaliticinterface.features.home.HomeController"
            stylesheets="@../css/home.css" onMousePressed="#onDragPressed" onMouseDragged="#onDragMoved">
    <left>
        <VBox prefWidth="220" styleClass="side-menu, home-sidebar">
            <StackPane styleClass="sidebar-header" minHeight="-Infinity"
                       prefHeight="${workspaceHeader.height}" maxHeight="-Infinity">
                <Button styleClass="side-button" maxWidth="Infinity" text="Menu" onAction="#onHomeGoClick">
                    <graphic>
                        <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                            <Image url="@../images/Ícone-qualifica-branco.png"
                                   requestedWidth="64" requestedHeight="64" preserveRatio="true" smooth="true"/>
                        </ImageView>
                    </graphic>
                </Button>
            </StackPane>
            <Separator styleClass="menu-divider"/>
            <VBox styleClass="sidebar-links" spacing="30">
                <VBox alignment="CENTER">
                    <Label text="Cadastros"
                           styleClass="sidebar-section-title"/>
                </VBox>
                <Button styleClass="side-button" maxWidth="Infinity" text="Inscrições" onAction="#onPageClick">
                    <graphic>
                        <StackPane minWidth="20" prefWidth="20" maxWidth="20">
                            <FontIcon iconLiteral="fas-clipboard-list"/>
                        </StackPane>
                    </graphic>
                    <userData>
                        <String fx:value="/views/pages/registers/registers.fxml"/>
                    </userData>
                </Button>
                <Button styleClass="side-button" maxWidth="Infinity" text="Pessoas" onAction="#onPageClick">
                    <graphic>
                        <StackPane minWidth="20" prefWidth="20" maxWidth="20">
                            <FontIcon iconLiteral="fas-users"/>
                        </StackPane>
                    </graphic>
                    <userData>
                        <String fx:value="/views/pages/people/people.fxml"/>
                    </userData>
                </Button>
                <Button styleClass="side-button" maxWidth="Infinity" text="Cursos" onAction="#onPageClick">
                    <graphic>
                        <StackPane minWidth="20" prefWidth="20" maxWidth="20">
                            <FontIcon iconLiteral="fas-graduation-cap"/>
                        </StackPane>
                    </graphic>
                    <userData>
                        <String fx:value="/views/pages/courses/courses.fxml"/>
                    </userData>
                </Button>
                <Button styleClass="side-button" maxWidth="Infinity" text="Aulas" onAction="#onPageClick">
                    <graphic>
                        <StackPane minWidth="20" prefWidth="20" maxWidth="20">
                            <FontIcon iconLiteral="fas-calendar-alt"/>
                        </StackPane>
                    </graphic>
                    <userData>
                        <String fx:value="/views/pages/classes/classes.fxml"/>
                    </userData>
                </Button>
            </VBox>
            <Separator styleClass="menu-divider"/>
            <VBox styleClass="sidebar-links" spacing="30">
                <VBox alignment="CENTER">
                    <Label text="Gestão" styleClass="sidebar-section-title"/>
                </VBox>
                <Button styleClass="side-button" maxWidth="Infinity" text="Usuários" onAction="#onPageClick">
                    <graphic>
                        <StackPane minWidth="20" prefWidth="20" maxWidth="20">
                            <FontIcon iconLiteral="fas-user-cog"/>
                        </StackPane>
                    </graphic>
                    <userData>
                        <String fx:value="/views/pages/users/users.fxml"/>
                    </userData>
                </Button>
                <Button styleClass="side-button" maxWidth="Infinity" text="Estatísticas" onAction="#onPageClick">
                    <graphic>
                        <StackPane minWidth="20" prefWidth="20" maxWidth="20">
                            <FontIcon iconLiteral="fas-chart-bar"/>
                        </StackPane>
                    </graphic>
                    <userData>
                        <String fx:value="/views/pages/superset.fxml"/>
                    </userData>
                </Button>
            </VBox>
        </VBox>
    </left>
    <center>
        <BorderPane fx:id="workspace">
            <top>
                <HBox fx:id="workspaceHeader" prefWidth="220" styleClass="header">
                    <Label fx:id="pageTitle" styleClass="title" text="Menu"/>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Sair"
                            onAction="#onLogoutClick" styleClass="icon-button, logout-button">
                        <graphic>
                            <FontIcon iconLiteral="fas-sign-out-alt"/>
                        </graphic>
                    </Button>
                </HBox>
            </top>
            <center>
                <ScrollPane fx:id="homeContent" fitToWidth="true" styleClass="home-scroll">
                    <VBox styleClass="home-content" spacing="24">
                        <VBox styleClass="home-welcome" spacing="8">
                            <Label text="QUALIFICA+ IJUÍ" styleClass="home-eyebrow"/>
                            <Label fx:id="greeting" styleClass="home-greeting"/>
                            <Label text="Acompanhe o resumo das atividades." styleClass="home-description"/>
                            <HBox styleClass="home-date-row" spacing="10" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="fas-calendar-alt"/>
                                <Label fx:id="currentDate" styleClass="home-date"/>
                            </HBox>
                        </VBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Resumo geral" styleClass="home-card-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Atualizar" onAction="#onRefreshSummary" styleClass="home-refresh">
                                <graphic>
                                    <FontIcon iconLiteral="fas-sync-alt"/>
                                </graphic>
                            </Button>
                        </HBox>
                        <FlowPane hgap="18" vgap="18">
                            <VBox styleClass="home-card, home-card-courses" spacing="10">
                                <FontIcon iconLiteral="fas-graduation-cap"/>
                                <Label text="Cursos ativos" styleClass="home-card-title"/>
                                <Label fx:id="coursesCount" styleClass="home-card-value"/>
                                <Label fx:id="coursesState" styleClass="home-card-description" wrapText="true"/>
                            </VBox>
                            <VBox styleClass="home-card, home-card-registers" spacing="10">
                                <FontIcon iconLiteral="fas-clipboard-list"/>
                                <Label text="Inscrições ativas" styleClass="home-card-title"/>
                                <Label fx:id="registersCount" styleClass="home-card-value"/>
                                <Label fx:id="registersState" styleClass="home-card-description" wrapText="true"/>
                            </VBox>
                            <VBox styleClass="home-card, home-card-people" spacing="10">
                                <FontIcon iconLiteral="fas-users"/>
                                <Label text="Pessoas cadastradas" styleClass="home-card-title"/>
                                <Label fx:id="peopleCount" styleClass="home-card-value"/>
                                <Label fx:id="peopleState" styleClass="home-card-description" wrapText="true"/>
                            </VBox>
                            <VBox styleClass="home-card, home-card-classes" spacing="10">
                                <FontIcon iconLiteral="fas-calendar-alt"/>
                                <Label text="Aulas de hoje" styleClass="home-card-title"/>
                                <Label fx:id="classesCount" styleClass="home-card-value"/>
                                <Label fx:id="classesState" styleClass="home-card-description" wrapText="true"/>
                            </VBox>
                        </FlowPane>
                    </VBox>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
