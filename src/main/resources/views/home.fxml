<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Separator?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import java.lang.String?>
<?import javafx.scene.layout.Region?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.qualificamaisanaliticinterface.features.home.HomeController">

    <left>
        <VBox prefWidth="220" styleClass="side-menu" spacing="20">
            <HBox alignment="CENTER_LEFT" spacing="2">
                <Label text="Qualifica"
                       styleClass="title, brand-name"/>
                <Label text="+"
                       styleClass="title, brand-plus"/>
                <Label text="Ijui"
                       styleClass="title, brand-city"/>
            </HBox>
            <Separator styleClass="menu-divider"/>
            <Button styleClass="side-button" text="Inscrições" onAction="#onPageClick">
                <userData>
                    <String fx:value="/views/pages/registers.fxml"/>
                </userData>
            </Button>
            <Button styleClass="side-button" text="Pessoas" onAction="#onPageClick">
                <userData>
                    <String fx:value="/views/pages/people.fxml"/>
                </userData>
            </Button>
            <Button styleClass="side-button" text="Cursos" onAction="#onPageClick">
                <userData>
                    <String fx:value="/views/pages/courses.fxml"/>
                </userData>
            </Button>
            <Button styleClass="side-button" text="Aulas" onAction="#onPageClick">
                <userData>
                    <String fx:value="/views/pages/classes.fxml"/>
                </userData>
            </Button>
            <Button styleClass="side-button" text="Usuários" onAction="#onPageClick">
                <userData>
                    <String fx:value="/views/pages/users.fxml"/>
                </userData>
            </Button>
            <Label text="Gestão"
                   styleClass="sub-title"/>

            <Button styleClass="side-button" text="Estatísticas" onAction="#onPageClick">
            <userData>
                <String fx:value="/views/pages/superset.fxml"/>
            </userData>
            </Button>
        </VBox>
    </left>
    <center>
        <BorderPane fx:id="workspace">
            <top>
                <HBox prefWidth="220" styleClass="header">
                    <Label text="Caminho da pagina atual"/>

                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Voltar"
                            onAction="#onGoBackClick"/>
                </HBox>
            </top>
            <center>
                <VBox styleClass="content" spacing="20">
                    <Label text="pagina"/>
                </VBox>
            </center>
        </BorderPane>
    </center>
</BorderPane>
