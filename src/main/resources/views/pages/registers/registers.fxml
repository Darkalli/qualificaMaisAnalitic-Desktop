<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.qualificamaisanaliticinterface.features.registers.RegistersController">
    <VBox styleClass="content" spacing="16" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
        <HBox spacing="16" alignment="CENTER_LEFT">
            <VBox spacing="6">
                <Label text="Inscrições" styleClass="box-title"/>
                <Label text="Encontre aqui os registros das inscrições realizadas" styleClass="box-lower-sub-title"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER" styleClass="box">
                <Label text="Total de inscrições" styleClass="box-lower-title"/>
                <Label fx:id="totalRegistersLabel" text="—" styleClass="box-info-title"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="newRegister" text="+ Nova inscrição" onAction="#onNewRegisterClick"/>
        </HBox>
        <VBox styleClass="box" spacing="12">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="title" text="Buscar e filtros"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Limpar filtros" onAction="#onClearFiltersClick" styleClass="clear-filters"/>
            </HBox>
            <HBox spacing="12" alignment="BOTTOM_LEFT">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Buscar"/>
                    <TextField fx:id="searchField" promptText="Pesquisar por nome ou CPF..."
                               onAction="#onSearchClick" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Curso"/>
                    <ComboBox fx:id="courseFilter" promptText="Todos os cursos" minWidth="180"
                              prefWidth="220" maxWidth="280" styleClass="filter-field"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Situação"/>
                    <ComboBox fx:id="statusFilter" promptText="Todas as situações" minWidth="200"
                              prefWidth="200" styleClass="filter-field"/>
                </VBox>
                <Button text="Buscar" onAction="#onSearchClick"/>
            </HBox>
        </VBox>
        <VBox styleClass="box" spacing="12" VBox.vgrow="ALWAYS">
            <TableView fx:id="registersTable" styleClass="table" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="cpfsColumn" text="CPF" minWidth="125" prefWidth="140" maxWidth="155"/>
                    <TableColumn fx:id="namesColumn" text="Nome" minWidth="180" prefWidth="260"/>
                    <TableColumn fx:id="courseColumn" text="Curso" minWidth="180" prefWidth="250"/>
                    <TableColumn fx:id="dateColumn" text="Data" minWidth="100" prefWidth="110" maxWidth="125"/>
                    <TableColumn fx:id="statusColumn" text="Situação" minWidth="100" prefWidth="110" maxWidth="130"/>
                    <TableColumn fx:id="actionsColumn" text="Ações" minWidth="100" prefWidth="110" maxWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>
