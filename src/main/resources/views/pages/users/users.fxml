<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.qualificamaisanaliticinterface.features.users.UsersController">

    <VBox styleClass="content" spacing="16"
          AnchorPane.topAnchor="0"
          AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0">
        <HBox styleClass="content">
            <VBox>
                <Label styleClass="box-title" text="Usuários"/>
                <Label styleClass="box-lower-sub-title" text="Encontre aqui os usuários ativos no sistema"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER" styleClass="box">
                <Label styleClass="box-title" alignment="CENTER" text="Total de usuários"/>
                <Label fx:id="totalUsersLabel" styleClass="box-info-title" alignment="CENTER"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+  Novo Usuário" onAction="#onNewUserClick"/>
        </HBox>
        <HBox styleClass="box">
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Buscar e filtros"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink text="Limpar filtros"
                               onAction="#onClearFiltersClick"
                               styleClass="clear-filters"/>
                </HBox>
                <HBox spacing="12" alignment="BOTTOM_LEFT">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Buscar"/>
                        <TextField fx:id="searchField"
                                   promptText="Pesquisar por nome ou CPF..."
                                   onAction="#onSearchClick"
                                   styleClass="search-field"
                                   HBox.hgrow="ALWAYS"/>
                    </VBox>
                    <Button text="Buscar"
                            onAction="#onSearchClick"/>
                </HBox>
            </VBox>
        </HBox>
        <VBox styleClass="box" VBox.vgrow="ALWAYS">
            <TableView styleClass="table" fx:id="usersTable"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="nameColumn"
                                 text="Nome"
                                 prefWidth="140"/>

                    <TableColumn fx:id="roleColumn"
                                 text="Função"
                                 prefWidth="220"/>
                    <TableColumn fx:id="actionsColumn"
                                 text="Ações"
                                 prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>
