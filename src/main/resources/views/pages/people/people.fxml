<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.qualificamaisanaliticinterface.features.people.PeopleController">

    <VBox styleClass="content" spacing="16" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
        <HBox spacing="16" alignment="CENTER_LEFT">
            <VBox spacing="6">
                <Label styleClass="box-title"
                       text="Pessoas"/>
                <Label styleClass="box-lower-sub-title"
                       text="Encontre aqui as pessoas já registradas"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER" styleClass="box">
                <Label text="Total de pessoas" styleClass="box-lower-title"/>
                <Label fx:id="totalPeopleLabel" text="—" styleClass="box-info-title"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+  Novo Cadastro" onAction="#onNewPersonClick"/>
        </HBox>
        <HBox styleClass="box">
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="title" text="Buscar e filtros"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink text="Limpar filtros"
                               onAction="#onClearFiltersClick"
                               styleClass="clear-filters"/>
                </HBox>
                <HBox spacing="12" alignment="BOTTOM_LEFT">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Buscar"/>
                        <TextField fx:id="searchField"
                                   promptText="Pesquisar por nome ou CPF..."
                                   onAction="#onSearchClick"
                                   styleClass="search-field"
                                   HBox.hgrow="ALWAYS"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Curso"/>

                        <ComboBox fx:id="courseFilter"
                                  promptText="Todos os cursos"
                                  minWidth="180"
                                  prefWidth="180"
                                  styleClass="filter-field"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Períodos"/>

                        <ComboBox fx:id="periodFilter"
                                  promptText="Todos os períodos"
                                  minWidth="180"
                                  prefWidth="180"
                                  styleClass="filter-field"/>
                    </VBox>
                    <Button text="Buscar"
                            onAction="#onSearchClick"/>
                </HBox>
            </VBox>
        </HBox>
        <VBox styleClass="box" VBox.vgrow="ALWAYS">
            <TableView styleClass="table" fx:id="peopleTable"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="cpfsColumn"
                                 text="CPF"
                                 minWidth="130"
                                 prefWidth="140"
                                 maxWidth="150"/>
                    <TableColumn fx:id="namesColumn"
                                 text="Nome"
                                 minWidth="180"
                                 prefWidth="250"/>
                    <TableColumn fx:id="emailsColumn"
                                 text="Email"
                                 minWidth="180"
                                 prefWidth="250"/>
                    <TableColumn fx:id="cellphoneColumn"
                                 text="Telefone"
                                 minWidth="130"
                                 prefWidth="150"
                                 maxWidth="180"/>
                    <TableColumn fx:id="actionsColumn"
                                 text="Ações"
                                 minWidth="100"
                                 prefWidth="150"
                                 maxWidth="170"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>
