<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.qualificamaisanaliticinterface.features.home.PeopleController">

    <VBox styleClass="content" spacing="16"
          AnchorPane.topAnchor="0"
          AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0">
        <HBox styleClass="content">
            <VBox>
                <Label styleClass="box-title"
                       text="Pessoas"/>

                <Label styleClass="box-lower-sub-title"
                       text="Encontre aqui as pessoas já registradas"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER" styleClass="box">
                <Label styleClass="box-title"
                       alignment="CENTER"
                       text="Total de pessoas"/>
                <Label fx:id="totalPeopleLabel"
                       styleClass="box-info-title"
                       alignment="CENTER"
                       text="—"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+  Novo Cadastro"/>
        </HBox>
        <HBox styleClass="box">
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Buscar e filtros"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink text="Limpar filtros"
                               onAction="#onClearFiltersClick"
                               styleClass="clear-filters"/>
                </HBox>
                <HBox spacing="12" alignment="BOTTOM_LEFT">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Buscar"/>
                        <TextField fx:id="searchField"
                                   promptText="Pesquisar por nome ou CPF..."
                                   onAction="#onSearchClick"
                                   styleClass="search-field"
                                   HBox.hgrow="ALWAYS"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Curso"/>

                        <ComboBox fx:id="courseFilter"
                                  promptText="Todos os cursos"
                                  minWidth="180"
                                  prefWidth="180"
                                  styleClass="filter-field"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Períodos"/>

                        <ComboBox fx:id="periodFilter"
                                  promptText="Todos os períodos"
                                  minWidth="180"
                                  prefWidth="180"
                                  styleClass="filter-field"/>
                    </VBox>
                    <Button text="Buscar"
                            onAction="#onSearchClick"/>
                </HBox>
            </VBox>
        </HBox>
        <VBox styleClass="box" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" HBox.Hgrow="ALWAYS">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="peopleCountLabel"
                           text="Carregando..."
                           styleClass="box-title"/>
                    <Label text="encontradas"
                           styleClass="box-sub-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="2" alignment="CENTER_RIGHT">
                    <Label text="atualizado a"
                           styleClass="box-border-text"/>
                </HBox>
            </HBox>
            <TableView styleClass="table" fx:id="peopleTable"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="cpfsColumn"
                                 text="CPF"
                                 prefWidth="180"/>

                    <TableColumn fx:id="namesColumn"
                                 text="Nome"
                                 prefWidth="400"/>
                </columns>
            </TableView>
            <HBox styleClass="table-footer"
                  spacing="8"
                  alignment="CENTER_LEFT">
                <Label fx:id="pageInfoLabel"
                       text="Carregando..."
                       styleClass="footer-text"/>
                <ComboBox fx:id="pageSizeCombo"
                          promptText="7 por página"
                          prefWidth="120"
                          styleClass="page-size"
                          disable="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Pagination fx:id="tablePagination"
                            pageCount="1"
                            maxPageIndicatorCount="5"/>
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>
