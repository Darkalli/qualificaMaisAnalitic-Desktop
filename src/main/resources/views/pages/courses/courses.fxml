<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.qualificamaisanaliticinterface.features.courses.CoursesController">
    <VBox styleClass="content" spacing="16" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
        <HBox spacing="16" alignment="CENTER_LEFT">
            <VBox spacing="6">
                <Label text="Cursos" styleClass="box-title"/>
                <Label text="Encontre aqui os cursos registrados" styleClass="box-lower-sub-title"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER" styleClass="box">
                <Label text="Total de cursos" styleClass="box-lower-title"/>
                <Label fx:id="totalCoursesLabel" text="—" styleClass="box-info-title"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="newCourse" text="+ Novo curso" onAction="#onNewCourseClick"/>
        </HBox>
        <GridPane styleClass="box" hgap="12" vgap="8">
            <columnConstraints>
                <ColumnConstraints percentWidth="40"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="10"/>
            </columnConstraints>
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="title" text="Buscar e filtros"/>
            </VBox>
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Buscar"/>
                <TextField fx:id="searchField" promptText="Pesquisar por nome..."
                           onAction="#onSearchClick" styleClass="search-field"/>
            </VBox>
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Período"/>
                <ComboBox fx:id="periodFilter" promptText="Todos os períodos" minWidth="180"
                          prefWidth="220" maxWidth="280" styleClass="filter-field"/>
            </VBox>
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Situação"/>
                <ComboBox fx:id="statusFilter" promptText="Todas as situações" minWidth="180"
                          prefWidth="220" maxWidth="280" styleClass="filter-field"/>
            </VBox>
            <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label text="Começo do curso"/>
                <DatePicker fx:id="startFilter" promptText="Começo" minWidth="180"
                          prefWidth="220" maxWidth="280" styleClass="register-date"/>
            </VBox>
            <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="1">
                <Label text="Final do curso"/>
                <DatePicker fx:id="finishFilter" promptText="Final" minWidth="180"
                          prefWidth="220" maxWidth="280" styleClass="register-date"/>
            </VBox>
            <VBox alignment="TOP_RIGHT" GridPane.columnIndex="3" GridPane.rowIndex="0">
            <Hyperlink text="Limpar filtros" onAction="#onClearFiltersClick" styleClass="clear-filters"/>
            </VBox>
            <VBox alignment="BOTTOM_RIGHT" GridPane.columnIndex="3" GridPane.rowIndex="1">
                <Button text="Buscar" onAction="#onSearchClick"/>
            </VBox>
        </GridPane>
        <VBox styleClass="box" spacing="12" VBox.vgrow="ALWAYS">
            <TableView fx:id="coursesTable" styleClass="table" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="namesColumn" text="Nome"
                                 minWidth="160" prefWidth="220" style="-fx-wrap-text: true;"/>
                    <TableColumn fx:id="descriptionColumn" text="Descrição"
                                 minWidth="180" prefWidth="300" style="-fx-wrap-text: true;"/>
                    <TableColumn fx:id="periodColumn" text="Período"
                                 minWidth="90" prefWidth="100" maxWidth="110"/>
                    <TableColumn fx:id="startColumn" text="Início"
                                 minWidth="105" prefWidth="110" maxWidth="120"/>
                    <TableColumn fx:id="finishColumn" text="Final"
                                 minWidth="105" prefWidth="110" maxWidth="120"/>
                    <TableColumn fx:id="statusColumn" text="Situação"
                                 minWidth="100" prefWidth="110" maxWidth="125"/>
                    <TableColumn fx:id="actionsColumn" text="Ações"
                                 minWidth="145" prefWidth="150" maxWidth="160"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>
