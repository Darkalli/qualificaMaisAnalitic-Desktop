<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<DialogPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.qualificamaisanaliticinterface.features.courses.CoursesFormController"
            fx:id="formDialogPane" prefWidth="620" styleClass="dialog-pane"
            onMousePressed="#onDragPressed" onMouseDragged="#onDragMoved">
    <content>
        <VBox spacing="20" styleClass="content">
            <Label text="Novo Curso" styleClass="title"/>
            <VBox styleClass="box" spacing="16">
                <VBox spacing="6">
                    <Label text="Nome" styleClass="box-lower-sub-title"/>
                    <TextField fx:id="nameField" promptText="Nome do curso"
                                        maxWidth="Infinity" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Descrição do curso" styleClass="box-lower-sub-title"/>
                    <TextField fx:id="descriptionField" promptText="Descrição do curso"
                               maxWidth="Infinity" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="período do curso" styleClass="box-lower-sub-title"/>
                    <ComboBox fx:id="periodField" promptText="Período do curso"
                               maxWidth="Infinity" styleClass="filter-field"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Data de inicio" styleClass="box-lower-sub-title"/>
                    <DatePicker fx:id="startField" maxWidth="Infinity" styleClass="register-date"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Data de Finalização" styleClass="box-lower-sub-title"/>
                    <DatePicker fx:id="finishField" maxWidth="Infinity" styleClass="register-date"/>
                </VBox>
            </VBox>
            <Label fx:id="info" styleClass="register-message" wrapText="true"
                   minHeight="-Infinity" maxWidth="560"/>
            <HBox spacing="12">
                <Button fx:id="close" text="Cancelar" onAction="#onClickCancel"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="add" text="Inscrever" onAction="#onClickAddCourse"/>
            </HBox>
        </VBox>
    </content>
</DialogPane>
