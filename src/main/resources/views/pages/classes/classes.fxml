<?xml version="1.0" encoding="UTF-8"?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import org.controlsfx.control.SearchableComboBox?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.qualificamaisanaliticinterface.features.classes.ClassesController">

    <VBox styleClass="content" spacing="16"
          AnchorPane.topAnchor="0"
          AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0">
        <HBox spacing="12" styleClass="content">
            <VBox>
                <Label styleClass="box-title" text="Aulas"/>
                <Label styleClass="box-lower-sub-title"
                       text="Encontre aqui as aulas realizadas, realizando ou a realizar"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER" styleClass="box">
                <Label styleClass="box-title" alignment="CENTER" text="Média de presença"/>
                <Label fx:id="presence" styleClass="box-info-title" alignment="CENTER"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Adicionar aula" onAction="#onNewClassClick" styleClass="icon-button">
                <graphic>
                    <FontIcon iconLiteral="fas-plus"/>
                </graphic>
            </Button>
        </HBox>
        <HBox styleClass="box">
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="title, icon-heading" text="Buscar e filtros">
                        <graphic>
                            <FontIcon iconLiteral="fas-filter"/>
                        </graphic>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink text="Limpar filtros" fx:id="cleanFilter"
                               onAction="#onClearFiltersClick"
                               styleClass="clear-filters, icon-link">
                        <graphic>
                            <FontIcon iconLiteral="fas-eraser"/>
                        </graphic>
                    </Hyperlink>
                </HBox>
                <HBox spacing="12" alignment="BOTTOM_LEFT">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Buscar"/>
                        <SearchableComboBox fx:id="courseField"
                                            promptText="Selecione um curso"
                                            styleClass="filter-field"
                                            HBox.hgrow="ALWAYS"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Data"/>
                        <DatePicker fx:id="dateFilter"
                                  promptText="Data de inicio"
                                  minWidth="180"
                                  prefWidth="180"
                                  styleClass="register-date"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Períodos"/>
                        <ComboBox fx:id="periodFilter"
                                  promptText="Todos os períodos"
                                  minWidth="180"
                                  prefWidth="180"
                                  styleClass="filter-field"/>
                    </VBox>
                    <Button text="Buscar" fx:id="search"
                            onAction="#onSearchClick" styleClass="icon-button">
                        <graphic>
                            <FontIcon iconLiteral="fas-search"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </HBox>
        <VBox styleClass="box" VBox.vgrow="ALWAYS">
            <TableView styleClass="table" fx:id="classesTable"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="courseColumn"
                                 text="Curso"
                                 prefWidth="200"/>
                    <TableColumn fx:id="dateColumn"
                                 text="Data"
                                 prefWidth="110"/>
                    <TableColumn fx:id="periodColumn"
                                 text="Periodo"
                                 prefWidth="110"/>
                    <TableColumn fx:id="startColumn"
                                 text="Começo"
                                 prefWidth="110"/>
                    <TableColumn fx:id="finishColumn"
                                 text="fim"
                                 prefWidth="110"/>
                    <TableColumn fx:id="statusColumn"
                                 text="Situação"
                                 prefWidth="130"/>
                    <TableColumn fx:id="actionsColumn"
                                 text="Ações"
                                 prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>
