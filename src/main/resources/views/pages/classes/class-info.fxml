<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.SearchableComboBox?>
<DialogPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.qualificamaisanaliticinterface.features.classes.ClassInfoController"
            fx:id="infoDialogPane" prefWidth="620" styleClass="dialog-pane"
            onMousePressed="#onDragPressed" onMouseDragged="#onDragMoved">
    <content>
        <VBox spacing="20" styleClass="content" style="-fx-padding: 24 24 12 24;">
            <Label text="Nova inscrição" styleClass="title"/>
            <VBox styleClass="box" spacing="16">
                <VBox spacing="6">
                    <Label text="Curso" styleClass="box-lower-sub-title"/>
                    <Label fx:id="courseField" maxWidth="Infinity" styleClass="filter-field"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Dia da aula" styleClass="box-lower-sub-title"/>
                    <Label fx:id="dateField" maxWidth="Infinity" styleClass="register-date"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Começo da aula" styleClass="box-lower-sub-title"/>
                    <Label fx:id="startField" maxWidth="Infinity" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Final da aula" styleClass="box-lower-sub-title"/>
                    <Label fx:id="finishField" maxWidth="Infinity" styleClass="search-field"/>
                </VBox>
            </VBox>
            <TableView styleClass="table" fx:id="peopleTable"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="namesColumn"
                                 text="Nome"
                                 minWidth="160"
                                 prefWidth="220"/>
                    <TableColumn fx:id="personActionsColumn"
                                 text="Ações"
                                 minWidth="190"
                                 prefWidth="200"
                                 maxWidth="220"/>
                </columns>
            </TableView>
            <Label fx:id="info" styleClass="register-message" wrapText="true"
                   minHeight="-Infinity" maxWidth="560"/>
            <HBox spacing="12">
                <Button fx:id="close" text="Cancelar" onAction="#onClickCancel"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="confirm" text="Salvar presenças" onAction="#onSavePresencesClick"/>
            </HBox>
        </VBox>
    </content>
</DialogPane>
