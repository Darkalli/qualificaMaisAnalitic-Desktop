<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.SearchableComboBox?>
<DialogPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.qualificamaisanaliticinterface.features.classes.ClassFormController"
            fx:id="formDialogPane" prefWidth="620" styleClass="dialog-pane"
            onMousePressed="#onDragPressed" onMouseDragged="#onDragMoved">
    <content>
        <VBox spacing="20" styleClass="content">
            <Label text="Nova inscrição" styleClass="title"/>
            <VBox styleClass="box" spacing="16">
                <VBox spacing="6">
                    <Label text="Curso" styleClass="box-lower-sub-title"/>
                    <SearchableComboBox fx:id="courseField" promptText="Selecione um curso"
                                        maxWidth="Infinity" visibleRowCount="6" styleClass="filter-field"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Dia da aula" styleClass="box-lower-sub-title"/>
                    <DatePicker fx:id="dateField" maxWidth="Infinity" styleClass="register-date"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Começo da aula" styleClass="box-lower-sub-title"/>
                    <TextField fx:id="startField" promptText="HH:mm" maxWidth="Infinity" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Final da aula" styleClass="box-lower-sub-title"/>
                    <TextField fx:id="finishField" promptText="HH:mm" maxWidth="Infinity" styleClass="search-field"/>
                </VBox>
            </VBox>
            <Label fx:id="info" styleClass="register-message" wrapText="true"
                   minHeight="-Infinity" maxWidth="560"/>
            <HBox spacing="12">
                <Button fx:id="close" text="Cancelar" onAction="#onClickCancel"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="add" text="Inscrever" onAction="#onClickAddClass"/>
            </HBox>
        </VBox>
    </content>
</DialogPane>
